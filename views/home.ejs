<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/css/output.css" />
    <title>AluthCamp</title>
  </head>
  <body
    class="flex flex-col h-screen bg-[linear-gradient(rgba(0,0,0,0.6),rgba(0,0,0,0.4)),url(/img/home2.jpg)] bg-cover bg-center text-white">
    <%- include('partials/navbar') %>
    <main class="container self-center mt-auto mb-auto">
      <h1 class="text-5xl text-center">AluthCamp - Sri Lanka</h1>
      <p class="text-center mt-3">
        Wlcome to AluthCamp!
        <br />
        Step away from the noise and let the island's rhythm pull you in. Whether you are waking up
        to misty peaks in the Knuckles, listening to river currents in Belihuloya, or stargazing by
        a crackling campfire under the Southern skies, you are home under the stars. Take a deep
        breath of clean mountain or jungle air, leave your worries behind, and let the wild show you
        its peace.⛺
        <br />
        <a
          href="/campgrounds"
          class="inline-flex items-center border-2 border-green-700 font-medium leading-5 rounded-xl text-sm px-4 py-2.5 shadow-md hover:bg-green-700/70 hover:text-white hover:border-transparent transition-colors duration-300 ease-in-out mt-3">
          Explore Campgrounds
          <svg
            class="w-4 h-4 ms-1.5 rtl:rotate-180 -me-0.5"
            aria-hidden="true"
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            fill="none"
            viewBox="0 0 24 24">
            <path
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M19 12H5m14 0-4 4m4-4-4-4" />
          </svg>
        </a>
      </p>
    </main>
    <%- include('partials/footer') %>
  </body>
</html>
