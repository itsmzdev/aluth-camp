<% layout('layouts/boilerplate.ejs') %>
<form action="/campgrounds/<%= campground._id %>?_method=put" method="post" class="validated-form" enctype="multipart/form-data" novalidate>
  <div class="mt-10 gap-x-6 flex flex-col items-center max-w-2xl mx-auto py-6 bg-[#4F6F52]/50 rounded-lg shadow-lg">
    <h1 class="text-3xl font-medium mb-3 border-b-3 pb-1 border-green-700">Edit Campground</h1>
    <div class="w-6/12">
      <label for="title" class="block text-sm/6 font-medium">Title</label>
      <div class="mt-2">
        <input
          id="title"
          type="text"
          required
          name="campground[title]"
          placeholder="Title"
          value="<%= campground.title %>"
          class="block w-full rounded-md min-w-0 grow px-3 py-2 text-base placeholder:text-white/60 outline-1 -outline-offset-1 outline-white focus:outline-2 focus:-outline-offset-2 focus:outline-green-600 sm:text-sm/6 transition-colors" />
        <p class="invisible text-red-800 text-sm mt-1">Please enter title.</p>
      </div>
    </div>
    <div class="w-6/12">
      <label for="location" class="block text-sm/6 font-medium">Location</label>
      <div class="mt-2">
        <input
          id="location"
          type="text"
          required
          name="campground[location]"
          placeholder="Location"
          value="<%= campground.location %>"
          class="block w-full rounded-md min-w-0 grow px-3 py-2 text-base placeholder:text-white/60 outline-1 -outline-offset-1 outline-white focus:outline-2 focus:-outline-offset-2 focus:outline-green-600 sm:text-sm/6 transition-colors" />
        <p class="invisible text-red-800 text-sm mt-1">Please enter location.</p>
      </div>
    </div>
    <div class="w-6/12">
      <label for="price" class="block text-sm/6 font-medium">Campground Price</label>
      <div class="mt-2">
        <input
          id="price"
          type="text"
          required
          name="campground[price]"
          placeholder="$ 0.00"
          value="<%= campground.price %>"
          class="block w-full rounded-md min-w-0 grow px-3 py-2 text-base placeholder:text-white/60 outline-1 -outline-offset-1 outline-white focus:outline-2 focus:-outline-offset-2 focus:outline-green-600 sm:text-sm/6 transition-colors" />
        <p class="invisible text-red-800 text-sm mt-1">Please enter price.</p>
      </div>
    </div>
    <div class="w-6/12">
      <label for="description" class="block text-sm/6 font-medium">Description</label>
      <div class="mt-2">
        <textarea
          id="description"
          name="campground[description]"
          required
          rows="3"
          class="block w-full min-h-[5lh] field-sizing-content rounded-md px-3 py-1.5 text-base placeholder:text-white/60 outline-1 -outline-offset-1 outline-white focus:outline-2 focus:-outline-offset-2 focus:outline-green-600 sm:text-sm/6 transition-colors">
          <%= campground.description %></textarea
        >
        <p class="invisible text-red-800 text-sm mt-1">Please enter description.</p>
      </div>
    </div>
    <div class="w-6/12">
      <label for="image" class="block text-sm/6 font-medium">Add More Images</label>
      <div class="mt-2">
        <input
          id="image"
          type="file"
          name="image"
          class="block cursor-pointer w-full rounded-md min-w-0 grow text-base file:cursor-pointer file:px-3 file:py-2 file:bg-[#4F6F52]/50 file: text-white/60 outline-1 -outline-offset-1 outline-white focus:outline-2 focus:-outline-offset-2 focus:outline-green-600 sm:text-sm/6 transition-colors"
          multiple />
        <p class="invisible text-red-800 text-sm mt-1">Please upload image.</p>
      </div>
    </div>
    <div class="w-6/12">
      <h2 class="italic">Please select one or more images to be removed</h2>
      <div class="flex flex-wrap gap-2 mt-2 mb-3">
        <% campground.images.forEach((img, i) => { %>
          <label class="relative block cursor-pointer w-40 aspect-square">
            <img class="object-cover w-full h-full rounded-xl hover:-translate-y-2 duration-300 ease-out" src="<%= img.thumbnail %>" alt="">
            <input class="absolute top-3 right-3 hover:-translate-y-2 duration-300 ease-out" type="checkbox" name="deleteImages[]" id="image-<%= i %>" value="<%= img.filename %>">
          </label>
        <% }); %>
      </div>
    </div>
    <div class="w-6/12 mt-2 flex items-center gap-x-6">
      <button
        type="submit"
        class="rounded-md bg-green-600 px-3 py-2 text-sm font-semibold text-white shadow-xs hover:bg-green-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-600 transition-colors">
        Update Campground
      </button>
      <div>
        <a href="/campgrounds/<%= campground._id %>" class="inline-flex items-center border-2 border-green-700/50 font-medium leading-5 rounded-xl text-sm px-4 py-2.5 shadow-sm hover:bg-green-700/70 hover:text-white hover:border-transparent transition-colors duration-300 ease-in-out">Campground <svg class="w-4 h-4 ms-1.5 rtl:rotate-180 -me-0.5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 12H5m14 0-4 4m4-4-4-4" />
          </svg></a>
        </a>
      </div>
    </div>
  </div>
</form>
