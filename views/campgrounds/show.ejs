<% layout('layouts/boilerplate.ejs') %>
<div class="flex gap-5 justify-center">
  <div class="max-w-lg w-5xl border rounded-lg shadow-xs self-start">
    <div class="<%= (campground.images.length > 1) ? 'carousel gap-3 flex' : "" %>">
      <% for (const image of campground.images) { %>
          <img class="carousel-wrap w-full object-cover h-100" src="<%= image.url %>" alt="" />
      <% } %>
    </div>
    <div class="p-6">
      <h5 class="mb-2 text-2xl font-semibold tracking-tight"><%= campground.title %> Details!</h5>
      <p class="mb-1"><%= campground.description %></p>
      <p class="mb-1 text-zinc-500"><%= campground.location %></p>
      <p class="mb-1">Submited by: <%= campground.author.username %></p>
      <p class="mb-1">$<%= campground.price %>/night</p>
      <% if (currentUser && campground.author.equals(currentUser._id)) { %>
        <a
        href="/campgrounds/<%= campground._id %>/edit"
        class="inline-block px-6 py-2 bg-blue-600 text-white font-medium text-sm rounded shadow-md hover:bg-blue-700 hover:shadow-lg focus:bg-blue-700 focus:outline-none active:bg-blue-800 transition duration-150 ease-in-out"
        >Edit</a
        >
        <form class="inline" action="/campgrounds/<%= campground._id %>?_method=delete" method="post">
          <button
          class="rounded-md bg-red-600 px-3 py-2 text-sm font-semibold text-white shadow-xs hover:bg-red-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 hover:shadow-lg transition duration-150 ease-in-out">
          Delete
        </button>
      <% } %>
      </div>
    </form>
  </div>
  <div class="max-w-lg w-5xl">
    <% if (currentUser) { %>
      <form action="/campgrounds/<%= campground._id %>/reviews" method="post" class="validated-form" novalidate>
        <h2 class="font-medium text-xl">Leave a Review</h2>
        <!-- <div class="mt-2">
          <label class="block font-medium" for="rating">Rating</label>
          <input class="block w-full" type="range" name="review[rating]" min="1" max="5" id="rating">
        </div> -->
        <div class="flex flex-row-reverse justify-end gap-1 [&>label]:text-gray-300 [&>label]:cursor-pointer [&>label:hover]:text-amber-400 [&>label:hover~label]:text-amber-400 [&>input:checked+label]:text-amber-400 [&>input:checked~label]:text-amber-400 [&>label]:p-1 [&>label:hover]:scale-110 [&>label]:transition-transform" >

          <input type="radio" id="star-5" name="review[rating]" value="5" class="hidden" />
          <label for="star-5">
            <svg class="w-8 h-8 fill-current" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
          </label>

          <input type="radio" id="star-4" name="review[rating]" value="4" class="hidden" />
          <label for="star-4">
            <svg class="w-8 h-8 fill-current" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
          </label>

          <input type="radio" id="star-3" name="review[rating]" value="3" class="hidden" />
          <label for="star-3" >
            <svg class="w-8 h-8 fill-current" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
          </label>

          <input type="radio" id="star-2" name="review[rating]" value="2" class="hidden" />
          <label for="star-2" >
            <svg class="w-8 h-8 fill-current" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
          </label>

          <input type="radio" id="star-1" name="review[rating]" value="1" class="hidden" checked/>
          <label for="star-1" >
            <svg class="w-8 h-8 fill-current" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
          </label>
        </div>
        <div class="mt-2">
          <label class="block font-medium mb-1" for="review">Review</label>
          <textarea class="block w-full border p-2" name="review[body]" id="review" cols="30" rows="5" required></textarea>
          <p class="invisible text-red-500 text-sm">Please add a review.</p>
        </div>
        <button class="mt-2 px-3 py-2 border border-[#198754] bg-[#198754] text-white hover:bg-[#157347] hover:border-[#146c43] p-2 rounded-md transition duration-150 ease-in-out" type="submit">Add Review</button>
      </form>
    <% } %>
    <% for (const review of campground.reviews) { %>
      <div class="border border-zinc-400 p-1 my-3 rounded-sm">
        <p class="text-l font-semibold">Rating: <%= review.rating %></p>
        <div class='flex gap-0.5'>
          <% for( let i = 0; i < review.rating; i++ ) { %>
              <svg class="w-6 h-6 fill-amber-400" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
          <% } %>
          <% for( let i = 0; i < 5 - review.rating; i++ ) { %>
              <svg class="w-6 h-6 stroke-amber-400 fill-white" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
          <% } %>
        </div>
        <p class="text-sm text-zinc-500">By <%= review.author.username %></p>
        <p>Review: <%= review.body %></p>
         <% if (currentUser && review.author.equals(currentUser._id)) { %>
          <form action="/campgrounds/<%= campground._id %>/reviews/<%= review._id %>?_method=delete" method="post">
            <button class="rounded-md bg-red-600 px-3 py-2 text-sm font-semibold text-white shadow-xs hover:bg-red-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 hover:shadow-lg transition duration-150 ease-in-out my-1">Delete</button>
          </form>
         <% } %> 
      </div>
    <% } %>
  </div>
</div>
