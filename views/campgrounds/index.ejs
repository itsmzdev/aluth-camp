<% layout('layouts/boilerplate.ejs') %>
<div id="map" class="w-full h-100 rounded-lg"></div>
<% for (let campground of campgrounds) { %>
    <div class="flex gap-1 p-6 mt-3 border-2 border-green-700/70 rounded-lg">
        <div class="w-1/2 md:w-1/3">
            <img class="rounded-lg w-full aspect-square object-cover shadow-lg" src="<%= campground.images[0].url %>" alt="" />
        </div>
        <div class="w-1/2 md:w-2/3 px-3">
            <a href="#" class="inline-block">
                <h5 class="mt-6 mb-2 text-2xl font-semibold tracking-tight border-b-3 pb-1 border-green-700"><%= campground.title %></h5>
            </a>
            <p class="mb-3"><%= campground.description %></p>
            <p class="mb-3 text-white"><svg xmlns="http://w3.org" viewBox="0 0 24 24" class="inline-flex size-7 fill-white stroke-green-700 stroke-2 drop-shadow-sm animate-bounce">
                <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg> <%= campground.location %></p>
            <a href="/campgrounds/<%= campground._id %>" class="inline-flex items-center border-2 border-green-700/50 font-medium leading-5 rounded-xl text-sm px-4 py-2.5 shadow-sm hover:bg-green-700/70 hover:text-white hover:border-transparent transition-colors duration-300 ease-in-out">
                View <%= campground.title %>
                <svg class="w-4 h-4 ms-1.5 rtl:rotate-180 -me-0.5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 12H5m14 0-4 4m4-4-4-4"/></svg>
            </a>
        </div>
    </div>
<% } %>

<%- "<script>" %>
const maptilerApiKey = "<%- process.env.MAPTILER_API_KEY %>";
const campgrounds = {
  type: "FeatureCollection",
  features: <%- JSON.stringify(
    campgrounds.map(campground => ({
      type: "Feature",
      geometry: campground.geometry,
      properties: { popUpMarkup: campground?.properties?.popUpMarkup }
    }))
  ) %>
};
<%- "</script>" %>

<script src="/js/clusterMap.js"></script>