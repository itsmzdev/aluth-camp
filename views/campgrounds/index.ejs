<% layout('layouts/boilerplate.ejs') %>
<% for (let campground of campgrounds) { %>
    <div class="flex gap-1 p-6 mt-3 border rounded-lg">
        <div class="w-full sm:w-1/2 md:w-1/3 lg:w-1/3 xl:1/3">
            <img class="rounded-lg" src="<%= campground.image %>" alt="" />
        </div>
        <div class="sm:w-1/2 md:w-2/3 lg:w-2/3 xl:1/3 px-3">
            <a href="#">
                <h5 class="mt-6 mb-2 text-2xl font-semibold tracking-tight"><%= campground.title %></h5>
            </a>
            <p class="mb-3"><%= campground.description %></p>
            <p class="mb-6 text-zinc-500"><%= campground.location %></p>
            <a href="/campgrounds/<%= campground._id %>" class="inline-flex items-center box-border border font-medium leading-5 rounded-lg text-sm px-4 py-2.5">
                View <%= campground.title %>
                <svg class="w-4 h-4 ms-1.5 rtl:rotate-180 -me-0.5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 12H5m14 0-4 4m4-4-4-4"/></svg>
            </a>
        </div>
    </div>
<% } %>