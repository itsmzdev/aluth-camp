<% layout('layouts/boilerplate') %>
<form action="/register" method="post" class="validated-form" novalidate>
  <div class="mt-10 flex flex-col md:flex-row max-w-2xl md:max-h-105 mx-auto bg-[#4F6F52]/50 rounded-lg shadow-lg overflow-hidden">
    <div class="w-full h-75 md:w-1/2 md:h-full">
      <img class="w-full h-full object-cover rounded-t-lg md:rounded-r-none md:rounded-l-lg" src="/img/register-card.jpg" alt="" />
    </div>
    <div class="w-full md:w-1/2 p-3">
      <h1 class="text-3xl font-medium mb-3 text-center">Register New User</h1>
      <div class="w-full">
        <label for="username" class="block text-sm/6 font-medium">Username</label>
        <div class="mt-2">
          <input
            id="username"
            type="text"
            required
            name="username"
            placeholder="Username"
            class="block w-full rounded-md min-w-0 grow px-3 py-2 text-base text-white placeholder:text-white/60 outline-1 -outline-offset-1 outline-white focus:outline-2 focus:-outline-offset-2 focus:outline-green-600 sm:text-sm/6 transition-colors"
            autofocus />
          <p class="invisible text-red-800 text-sm mt-1">Please enter username.</p>
        </div>
      </div>
      <div class="w-full">
        <label for="email" class="block text-sm/6 font-medium">Email</label>
        <div class="mt-2">
          <input
            id="email"
            type="email"
            required
            name="email"
            placeholder="Email"
            class="block w-full rounded-md min-w-0 grow px-3 py-2 text-base text-white placeholder:text-white/60 outline-1 -outline-offset-1 outline-white focus:outline-2 focus:-outline-offset-2 focus:outline-green-600 sm:text-sm/6 transition-colors" />
          <p class="invisible text-red-800 text-sm mt-1">Please enter email.</p>
        </div>
      </div>
      <div class="w-full">
        <label for="password" class="block text-sm/6 font-medium">Password</label>
        <div class="mt-2">
          <input
            id="password"
            type="password"
            required
            name="password"
            placeholder="Password"
            class="block w-full rounded-md min-w-0 grow px-3 py-2 text-base text-white placeholder:text-white/60 outline-1 -outline-offset-1 outline-white focus:outline-2 focus:-outline-offset-2 focus:outline-green-600 sm:text-sm/6 transition-colors" />
          <p class="invisible text-red-800 text-sm mt-1">Please enter password.</p>
        </div>
      </div>
      <div class="mt-2 flex items-center gap-x-6">
        <button
          type="submit"
          class="w-full rounded-md bg-green-600 px-3 py-2 text-sm font-semibold text-white shadow-xs hover:bg-green-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-600 transition-colors">
          Add User
        </button>
      </div>
    </div>
  </div>
</form>
