    "dev": "concurrently \"npm run watch-css\" \"npm run watch-server\""
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.3.1",
    "cloudinary": "^2.11.0",
    "connect-flash": "^0.1.1",
    "dotenv": "^17.4.2",
    "ejs": "^5.0.2",
    "ejs-mate": "^4.0.0",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "joi": "^18.2.3",
    "method-override": "^3.0.0",
    "mongoose": "^9.6.2",
    "multer": "^2.4.0",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "passport-local-mongoose": "^9.1.0",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.3"
  }
}
